  "settings": [
    {
      "name": "machine",
      "display": "setting.machine",
      "type": "enum",
      "options": [
        "cps1",
        "cps2",
        "cps3",
        "neogeo",
        "system16",
        "neocd"
      ],
      "default": "cps2",
      "description": "setting.machine.about"
    },
    {
      "name": "neogeo_bios",
      "display": "setting.neogeo_bios",
      "type": "enum",
      "options": [
        "MVS Asia/Europe ver. 6 (1 slot)",
        "MVS Asia/Europe ver. 5 (1 slot)",
        "MVS Asia/Europe ver. 3 (4 slot)",
        "MVS USA ver. 5 (2 slot)",
        "MVS USA ver. 5 (4 slot)",
        "MVS USA ver. 5 (6 slot)",
        "MVS USA (U4)",
        "MVS USA (U3)",
        "MVS Japan ver. 6 (? slot)",
        "MVS Japan ver. 5 (? slot)",
        "MVS Japan ver. 3 (4 slot)",
        "NEO-MVH MV1C (Asia)",
        "NEO-MVH MV1C (Japan)",
        "MVS Japan (J3)",
        "MVS Japan (J3, alt)",
        "AES Japan",
        "AES World",
        "Development Kit",
        "Deck ver. 6 (Git Ver 1.3)",
        "Universe BIOS (Hack, Ver. 4.0)",
        "Universe BIOS (Hack, Ver. 3.3)",
        "Universe BIOS (Hack, Ver. 3.2)",
        "Universe BIOS (Hack, Ver. 3.1)",
        "Universe BIOS (Hack, Ver. 3.0)",
        "Universe BIOS (Hack, Ver. 2.3)",
        "Universe BIOS (Hack, Ver. 2.3, older?)",
        "Universe BIOS (Hack, Ver. 2.2)",
        "Universe BIOS (Hack, Ver. 2.1)",
        "Universe BIOS (Hack, Ver. 2.0)",
        "Universe BIOS (Hack, Ver. 1.3)",
        "Universe BIOS (Hack, Ver. 1.2)",
        "Universe BIOS (Hack, Ver. 1.2, older)",
        "Universe BIOS (Hack, Ver. 1.1)",
        "Universe BIOS (Hack, Ver. 1.0)",
        "NeoOpen BIOS v0.1 beta"
      ],
      "default": "MVS Asia/Europe ver. 6 (1 slot)",
      "exposedWhen": {
        "setting": "machine",
        "is": "neogeo"
      },
      "description": "setting.neogeo_bios.about"
    },
    {
      "name": "cpu_clock",
      "display": "setting.cpu_clock",
      "type": "int",
      "default": 100,
      "min": 25,
      "max": 400,
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "cps1",
          "cps2",
          "neogeo",
          "system16"
        ]
      },
      "description": "setting.cpu_clock.about"
    },
    {
      "name": "force_60hz",
      "display": "setting.force_60hz",
      "type": "bool",
      "default": false,
      "description": "setting.force_60hz.about"
    },
    {
      "name": "socd",
      "display": "setting.socd",
      "type": "enum",
      "options": [
        "off",
        "neutral",
        "last-input-4way",
        "last-input-8way",
        "first-input",
        "up-priority",
        "down-priority"
      ],
      "default": "last-input-8way",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "cps1",
          "cps2",
          "cps3",
          "neogeo",
          "neocd"
        ]
      },
      "description": "setting.socd.about"
    },
    {
      "name": "pcm_interpolation",
      "display": "setting.pcm_interpolation",
      "type": "enum",
      "options": [
        "none",
        "2-point",
        "4-point"
      ],
      "default": "2-point",
      "description": "setting.pcm_interpolation.about"
    },
    {
      "name": "fm_interpolation",
      "display": "setting.fm_interpolation",
      "type": "enum",
      "options": [
        "none",
        "2-point",
        "4-point"
      ],
      "default": "none",
      "description": "setting.fm_interpolation.about"
    }
  ],
