{
  "_comment": "This file lists the ROM sets or the disc a project of this core takes. Chimera's New Project window is built from it. A project file records its files under the slot ids used here.",
  "slots": [
    {
      "id": "disc",
      "title": "slot.disc",
      "min": 1,
      "max": 1,
      "formats": [
        "cue",
        "chd"
      ],
      "exposedWhen": {
        "setting": "machine",
        "is": "neocd"
      },
      "help": "slot.disc.help"
    },
    {
      "id": "romset",
      "title": "slot.romset",
      "min": 1,
      "max": 4,
      "formats": [
        "zip"
      ],
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "cps1",
          "cps2",
          "cps3",
          "neogeo",
          "system16"
        ]
      },
      "help": "slot.romset.help"
    },
    {
      "id": "savedata",
      "title": "slot.savedata",
      "min": 0,
      "max": 8,
      "formats": [
        "bin"
      ],
      "help": "slot.savedata.help"
    }
  ]
}
